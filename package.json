{
  "name": "whiteboard",
  "version": "1.0.0",
  "description": "React based collaborative whiteboard app",
  "main": "main.tsx",
  "scripts": {
    "start": "webpack serve --config webpack/webpack.config.js --env env=dev",
    "build": "webpack --config webpack/webpack.config.js --env env=prod",
    "lint": "eslint \"./src/**/*.{js,jsx,ts,tsx,json}\" --fix",
    "format": "prettier \"./src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" --write",
    "format:write": "prettier \"./src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" --write",
    "format:check": "prettier \"./src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" --check",
    "stories": "start-storybook -p 3001 --no-open",
    "stories:build": "build-storybook"
  },
  "keywords": [],
  "author": "Kirill Nikolskiy",
  "license": "ISC",
